# Copy to .env.local and fill in.

# --- Required ---------------------------------------------------------------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Model ------------------------------------------------------------------
# gemini-3.5-flash handles video + audio natively and is cheap.
# Use a Pro model if you want deeper reasoning on complex videos.
# GEMINI_MODEL=gemini-3.5-flash

# --- Getting past Instagram / TikTok blocks ---------------------------------
# Instagram in particular refuses anonymous requests from datacenter IPs.
# Export cookies.txt (Netscape format) from a logged-in browser session.
# If the file is simply named cookies.txt in the project root it is picked up
# automatically; otherwise point at it here.
# COOKIES_FILE=/app/cookies.txt

# An outbound proxy for yt-dlp. Residential proxies work; datacenter ones are
# usually blocked too. This is the single most effective fix for "IP blocked".
# YTDLP_PROXY=http://user:pass@host:port

# Path to the yt-dlp binary. Unset, the app looks in node_modules/yt-dlp-exec/bin
# and then on $PATH. The Docker image sets this to the pip-installed yt-dlp.
# YTDLP_PATH=/usr/local/bin/yt-dlp

# --- Limits -----------------------------------------------------------------
# MAX_DURATION_S=600        # reject videos longer than this
# MAX_FILESIZE_MB=200       # reject downloads bigger than this
# COMPRESS_ABOVE_MB=45      # re-encode to 720p above this size
# CLIP_TTL_MINUTES=30       # how long downloaded clips stay on disk
