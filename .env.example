# Copy to .env.local for local development.
# On Railway, set these in the service's Variables tab instead.

# --- Required ---------------------------------------------------------------
# https://aistudio.google.com/apikey  (free tier, no credit card)
GEMINI_API_KEY=

# --- API access for n8n -----------------------------------------------------
# Shared secret for POST /api/transcribe — the endpoint automation calls.
# Leave it unset and that endpoint is open to anyone who finds the URL, and
# every call spends your Gemini quota. Generate one with:
#   openssl rand -hex 32
# API_KEY=

# Where the "Send to Notion" button posts the finished analysis.
# Unset, the button reports that it isn't configured.
# N8N_WEBHOOK_URL=https://n8n.yourcompany.com/webhook/social-transcriber

# Optional. Sent as X-Webhook-Secret so the workflow can verify the caller.
# N8N_WEBHOOK_SECRET=

# --- Model ------------------------------------------------------------------
# gemini-3.5-flash handles video and audio natively and is cheap.
# GEMINI_MODEL=gemini-3.5-flash

# --- Getting past Instagram / TikTok blocks ---------------------------------
# An outbound proxy for yt-dlp. Residential proxies work; datacenter ones are
# usually blocked too. This is the single most effective fix for "IP blocked".
# YTDLP_PROXY=http://user:pass@host:port

# Netscape-format cookies.txt from a logged-in browser. Required for private
# or age-restricted posts. Use a throwaway account.
# COOKIES_FILE=/app/cookies.txt

# Path to the yt-dlp binary. Unset, the app runs `yt-dlp` from $PATH.
# The Docker image pip-installs it and sets this.
# YTDLP_PATH=/usr/local/bin/yt-dlp

# --- Download retries -------------------------------------------------------
# Transient failures (timeouts, rate limits, server errors) are retried.
# Permanent ones (private, deleted, bad URL) fail immediately.
# DOWNLOAD_ATTEMPTS=5
# RETRY_BASE_MS=1000        # waits go 1s, 2s, 3s, 4s
# RETRY_MAX_MS=4000

# The browser only ever sees a generic "Couldn't download the video" for
# infrastructure failures; the real yt-dlp error goes to the server log.
# Set this while developing to show it in the browser too.
# SHOW_DOWNLOAD_ERROR_DETAILS=true

# --- Limits -----------------------------------------------------------------
# MAX_DURATION_S=600        # reject videos longer than this
# MAX_FILESIZE_MB=200       # reject downloads bigger than this
# COMPRESS_ABOVE_MB=45      # re-encode to 720p above this size
#                           # set very high on small containers — ffmpeg is
#                           # slow on a shared vCPU and Gemini accepts big files
# CLIP_TTL_MINUTES=30       # how long downloaded clips stay on disk
